PORT=3000
NODE_ENV=production

# Bind address. Leave unset (0.0.0.0) for local development. On EC2 behind Nginx
# set 127.0.0.1 so the API cannot be reached directly on port 3000.
# HOST=127.0.0.1

# Postgres. When the database runs on the same EC2 instance as this API, use
# localhost and leave port 5432 closed in the security group.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Signs the 7-day login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every issued token.
JWT_SECRET=

# Optional comma-separated CORS allowlist. Leave empty to allow all origins.
#
# Once Nginx serves the React build and the API from the same domain, the browser
# app is same-origin and needs no entry here. The Capacitor builds still do: they
# load from capacitor://localhost (iOS) and http://localhost (Android), so both
# must be listed or every mobile request fails preflight.
#   CORS_ORIGINS=https://morainmahj.com,https://www.morainmahj.com,capacitor://localhost,http://localhost
CORS_ORIGINS=

# Public app origin for email CTAs, push deep links, and Stripe return URL defaults.
APP_BASE_URL=https://morainmahj.com
# Optional app id stored in Stripe payment metadata.
APP_ID=

# Stripe (test mode keys for development — never commit live secrets)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Outbound email (Resend) — optional; skipped when unset
RESEND_API_KEY=
EMAIL_FROM=Morain Mahj <noreply@morainmahj.com>

# Push notifications (OneSignal) — optional; skipped when unset
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# SMS (Twilio) — required for sendBulkSMS / sendLeagueBulkSMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
